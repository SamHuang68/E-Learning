# Copy to .env.local for local development (never commit secrets).
#
# These are OPTIONAL. Leave them unset to run fully offline: the app falls
# back to a local (localStorage) backend so login + progress work without any
# cloud project. Set them to sync progress to a real hosted Supabase project.

# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anon/public key (safe for browser; protect data with RLS)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Local default is `/`.
# GitHub Actions sets this to `/<repo-name>/` for project Pages.
# VITE_BASE_PATH=/
