    {
      "dot": "emerald",
      "title": "High Write Throughput",
      "items": [
        "Random writes are transformed into sequential append-only writes via WAL and MemTable",
        "Zero in-place updates eliminate disk seek latency penalties"
      ]
    },
    {
      "dot": "cyan",
      "title": "Two-Tiered Memory Hierarchy",
      "items": [
        "SkipList provides concurrent O(log N) point lookup and range scan",
        "Immutable MemTable decouples write ingestion from disk flushing"
      ]
    },
    {
      "dot": "rose",
      "title": "Leveled Compaction Tradeoffs",
      "items": [
        "Background merge-sort maintains sorted order across non-overlapping partitions",
        "Bloom filters in SSTables eliminate unnecessary disk reads for non-existent keys"
      ]
    }
  ]
