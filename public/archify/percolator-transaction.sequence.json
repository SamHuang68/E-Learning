  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Lock Anchor",
      "items": [
        "The Primary Row serves as the single source of truth for transaction commit",
        "If coordinator crashes, recovery workers check the Primary Lock state to roll forward or backward"
      ]
    },
    {
      "dot": "cyan",
      "title": "Two-Phase Decentralized 2PC",
      "items": [
        "No centralized transaction coordinator holds persistent memory state",
        "BigTable row atomicity powers distributed multi-row ACID transactions"
      ]
    },
    {
      "dot": "rose",
      "title": "Snapshot Isolation Scaling",
      "items": [
        "Reads never block writes and writes never block reads",
        "Timestamp Oracle (TSO) provides strictly increasing global linear order"
      ]
    }
  ]
